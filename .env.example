# ---- App ----
NODE_ENV=development
PORT=3000
API_PREFIX=v1
FRONTEND_URL=http://localhost:5173

# ---- Postgres / TypeORM ----
DB_HOST=localhost
# 5433 by default to avoid clashing with a locally-installed Postgres on 5432 — matches
# the host-side port mapping in docker-compose.yml
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=better_screening
DB_SSL=false

# ---- Redis / BullMQ ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ---- Object storage (S3 / MinIO) ----
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true
STORAGE_BUCKET_RESUMES=bscreen-resumes-dev
STORAGE_BUCKET_RECORDINGS=bscreen-recordings-dev
STORAGE_SIGNED_URL_TTL_SECONDS=900

# ---- Mail (SMTP) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Better Screening <no-reply@betterscreening.app>"
SMTP_SECURE=false

# ---- LLM (question generation, email drafting, evaluation) ----
# groq | anthropic | mock (mock needs no key and returns canned responses)
LLM_PROVIDER=groq
# Groq key from https://console.groq.com/keys (gsk_...)
LLM_API_KEY=
# Groq: openai/gpt-oss-120b | openai/gpt-oss-20b | qwen/qwen3-32b
# Anthropic: claude-sonnet-5
LLM_MODEL=openai/gpt-oss-120b

# ---- Candidate portal ----
CANDIDATE_PORTAL_BASE_URL=http://localhost:5173/interview-room

# ---- Secret encryption (Gmail OAuth refresh tokens at rest) ----
# Any random 32+ char string, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# ---- Google OAuth (per-user "Connect Gmail" — Settings > Email & Gmail) ----
# Create in Google Cloud Console: APIs & Services > Credentials > OAuth client ID
# (Web application), enable the Gmail API, and add GOOGLE_OAUTH_REDIRECT_URI below as
# an authorized redirect URI. Scopes used: gmail.send, userinfo.email.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/v1/mail-accounts/gmail/callback

# ---- LiveKit (candidate interview room video + per-question Egress recording) ----
# Keys must match livekit/livekit.yaml and livekit/egress.yaml (secret >= 32 chars).
LIVEKIT_API_URL=http://localhost:7880
# What the candidate's browser connects to
LIVEKIT_WS_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=better-screening-dev-secret-change-me-0123456789
# MinIO/S3 endpoint as seen from the Egress container (host networking → localhost)
LIVEKIT_EGRESS_S3_ENDPOINT=http://localhost:9000

# ---- Transcription service (../transcript — run separately, see its docs/INTEGRATION.md) ----
# Its HTTP API — transcript text is read from GET /jobs/{id}
TRANSCRIPTION_API_URL=http://localhost:8000
# Host folder bind-mounted into the service as AUDIO_ROOT (/data/audio); each answer's
# recording is written here before its job is queued. Relative to where the backend runs.
TRANSCRIPTION_AUDIO_DIR=../transcript/data/audio
# Optional language hint (blank = the service's DEEPGRAM_LANGUAGE)
TRANSCRIPTION_LANGUAGE=en
